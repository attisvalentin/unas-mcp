{
  "name": "unas-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the UNAS webshop API",
  "type": "module",
  "bin": {
    "unas-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "docs:sync": "node dist/docs/cli.js"
  },
  "keywords": [
    "mcp",
    "unas",
    "webshop",
    "ecommerce"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "author": "Attila Valentin Németh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attisvalentin/unas-mcp.git"
  },
  "homepage": "https://github.com/attisvalentin/unas-mcp#readme",
  "bugs": {
    "url": "https://github.com/attisvalentin/unas-mcp/issues"
  }
}
